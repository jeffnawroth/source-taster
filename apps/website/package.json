{
  "name": "@source-taster/website",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    "./hosting": "./hosting.ts",
    "./metadata": "./src/metadata.ts"
  },
  "scripts": {
    "build": "node scripts/build.ts --preview",
    "build:publication": "node scripts/build.ts --publication",
    "publication:check": "node scripts/publication-check.ts",
    "preview": "node scripts/serve.ts --preview",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "i18n:check": "node scripts/content-check.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@source-taster/i18n": "workspace:*",
    "@source-taster/ui": "workspace:*",
    "astro": "7.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.4"
  }
}
