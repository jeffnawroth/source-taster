{
  "name": "@source-taster/web",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "prototype:identity": "vite --config prototype/identity/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test:e2e": "playwright test && playwright test --config bibliographic.playwright.config.ts",
    "test:e2e:cross-browser": "SOURCE_TASTER_E2E_CROSS_BROWSER=true pnpm test:e2e",
    "test:guest": "playwright test --config guest.playwright.config.ts",
    "test:quota": "playwright test --config quota.playwright.config.ts",
    "test:history": "playwright test --config history.playwright.config.ts"
  },
  "dependencies": {
    "@source-taster/contract-service": "workspace:*",
    "@source-taster/contract-verification": "workspace:*",
    "@source-taster/i18n": "workspace:*",
    "@source-taster/ui": "workspace:*",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@playwright/test": "1.64.1",
    "@source-taster/website": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "tailwindcss": "4.3.4",
    "vite": "8.3.5"
  }
}
