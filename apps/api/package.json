{
  "name": "@source-taster/api",
  "type": "module",
  "version": "3.0.0",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "keys": "tsx --env-file=.env src/cli/keys.ts",
    "key:create": "tsx --env-file=.env src/cli/keys.ts create",
    "key:list": "tsx --env-file=.env src/cli/keys.ts list",
    "key:revoke": "tsx --env-file=.env src/cli/keys.ts revoke"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.10",
    "@hono/zod-validator": "^0.7.6",
    "@source-taster/types": "workspace:^",
    "cheerio": "^1.2.0",
    "crypto-js": "^4.2.0",
    "damerau-levenshtein": "^1.0.8",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.30",
    "key-file-storage": "^2.3.3",
    "lodash": "^4.18.1",
    "normalize-url": "^9.0.1",
    "openai": "^5.23.2",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@source-taster/eslint-config": "workspace:^",
    "@types/cheerio": "^1.0.0",
    "@types/crypto-js": "^4.2.2",
    "@types/damerau-levenshtein": "^1.0.2",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.13.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
