// Tables of the verification service. They live in the `verification` schema,
// owned by the service's own role (see scripts/db-setup.ts). The job queue
// lives next to it in `verification_boss`, managed by pg-boss.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model Check {
  id             String          @id @db.Uuid
  apiVersion     Int             @default(1) @map("api_version")
  ownerId        String          @map("owner_id")
  /// Exact extracted/pasted document and current selection; expires with this Check.
  document       Json?
  actorId        String          @map("actor_id")
  guestContextId String? @map("guest_context_id") @db.Uuid
  /// Wire value of CheckState.
  state          String
  /// Sequence number of the newest CheckEvent.
  lastSeq        Int             @default(0) @map("last_seq")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  leaseExpiresAt DateTime        @default(dbgenerated("(CURRENT_TIMESTAMP + interval '75 seconds')")) @map("lease_expires_at") @db.Timestamptz(3)
  endedAt        DateTime?       @map("ended_at") @db.Timestamptz(3)
  startedAt      DateTime?       @map("started_at") @db.Timestamptz(3)
  /// Fixed ADR-0005 content deadline; set at creation, finalized at first end.
  contentExpiresAt DateTime      @map("content_expires_at") @db.Timestamptz(3)
  /// Set when the content was deleted; the row itself is the tombstone.
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz(3)
  endReason      String?         @map("end_reason")
  dispatchOrder  BigInt          @default(0) @map("dispatch_order")
  references     ReferenceSlot[]
  events         CheckEvent[]

  @@index([ownerId])
  @@index([contentExpiresAt], map: "checks_content_expiry")
  @@map("checks")
}

model ReferenceSlot {
  checkId      String            @map("check_id") @db.Uuid
  /// 1-based position within the Check.
  position     Int
  originalText String            @map("original_text")
  /// Current execution Status; final immutable result takes precedence.
  status       String
  structured   Json?
  removed      Boolean           @default(false)
  revisions    FieldRevision[]
  generation   Int               @default(0)
  revision     Int               @default(1)
  attempts     Int               @default(0)
  claimUntil   DateTime?         @map("claim_until") @db.Timestamptz(3)
  startedAt    DateTime?         @map("started_at") @db.Timestamptz(3)
  progress     String            @default("queued")
  results      ReferenceResult[]
  check        Check             @relation(fields: [checkId], references: [id], onDelete: Cascade)

  @@id([checkId, position])
  @@map("reference_slots")
}

model CheckEvent {
  checkId   String   @map("check_id") @db.Uuid
  seq       Int
  type      String
  /// The event's JSON `data` without the envelope fields seq, type and checkId.
  payload   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  check     Check    @relation(fields: [checkId], references: [id], onDelete: Cascade)

  @@id([checkId, seq])
  @@map("check_events")
}

// Append-only run content. #81 will add field revisions and cancellation fencing.
model ReferenceResult {
  id         String        @id @db.Uuid
  checkId    String        @map("check_id") @db.Uuid
  position   Int
  generation Int           @default(0)
  revision   Int           @default(1)
  content    Json
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  manualOverride ManualOverride?
  reference  ReferenceSlot @relation(fields: [checkId, position], references: [checkId, position], onDelete: Cascade, map: "reference_results_slot_fkey")

  @@unique([checkId, position, generation])
  @@index([checkId, position, createdAt], map: "reference_results_slot_created")
  @@map("reference_results")
}

model SourceRate {
  source String   @id
  nextAt DateTime @default(now()) @map("next_at") @db.Timestamptz(3)

  @@map("source_rates")
}

model SourceRequest {
  id        String   @id @db.Uuid
  source    String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([source, expiresAt], map: "source_requests_source_expiry")
  @@map("source_requests")
}

// Durable, idempotent handoff to the Quota journal. No balances, grants or debits here.
model SettlementIntent {
  checkId    String   @map("check_id") @db.Uuid
  position   Int
  generation Int
  outcome    String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Set once the private service acknowledged this intent; delivery is idempotent at the service.
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(3)

  @@index([deliveredAt, createdAt], map: "settlement_intents_pending")
  @@id([checkId, position, generation])
  @@map("settlement_intents")
}

model AuthorityFence {
 ownerId String @id @map("owner_id") @db.Uuid
 version Int
 @@map("authority_fences")
}

// Immutable snapshots: every user correction appends to the stable slot.
model FieldRevision {
  checkId String @map("check_id") @db.Uuid
  position Int
  revision Int
  content Json
  provenance String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  reference ReferenceSlot @relation(fields: [checkId, position], references: [checkId, position], onDelete: Cascade)
  @@id([checkId, position, revision])
  @@map("field_revisions")
}

// Separate user judgment, never part of immutable result content.
model ManualOverride {
  resultId String @id @map("result_id") @db.Uuid
  id String @unique @db.Uuid
  verdict String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  result ReferenceResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  @@map("manual_overrides")
}
