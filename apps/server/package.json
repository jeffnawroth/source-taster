{
  "name": "@source-taster/server",
  "version": "0.0.0",
  "private": true,
  "description": "Verification API: the web process (HTTP + SSE) and the worker process.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "db:setup": "node scripts/db-setup.ts",
    "db:migrate": "prisma migrate deploy",
    "db:export": "node scripts/export-database.ts",
    "web": "node src/web.ts",
    "worker": "node src/worker.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e:serve": "node scripts/e2e-serve.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/citation-assets.ts",
    "start:web": "node dist/web.js",
    "start:worker": "node dist/worker.js",
    "release:check": "node scripts/release-check.ts",
    "build:release": "pnpm release:check && pnpm build",
    "load:test": "node scripts/load-test.ts",
    "test:load": "vitest run --config load.vitest.config.ts",
    "test:authority": "vitest run --config guest.vitest.config.ts",
    "extractor:image": "node scripts/extractor-image.ts"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@hono/zod-openapi": "1.6.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@source-taster/contract-common": "workspace:*",
    "@source-taster/contract-internal": "workspace:*",
    "@source-taster/contract-service": "workspace:*",
    "@source-taster/contract-verification": "workspace:*",
    "@source-taster/core": "workspace:*",
    "@source-taster/website": "workspace:*",
    "bibliojson": "4.1.0",
    "citeproc": "2.4.63",
    "hono": "4.13.14",
    "jszip": "3.10.2",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "saxes": "6.0.0",
    "zod": "4.6.7"
  }
}
