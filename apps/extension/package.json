{
  "name": "@source-taster/extension",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "vite build --mode chromium && vite build --mode firefox",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test:native-account": "playwright test --config account.playwright.config.ts",
    "test:native": "playwright test",
    "test:native-selection": "playwright test --config selection.playwright.config.ts",
    "test:native-ai": "playwright test --config ai.playwright.config.ts",
    "test:native-report": "playwright test --config report.playwright.config.ts",
    "test:native-guest": "playwright test --config guest.playwright.config.ts",
    "test:native-firefox": "playwright test --config firefox.playwright.config.ts",
    "test:native-history": "playwright test --config history.playwright.config.ts"
  },
  "dependencies": {
    "@source-taster/contract-service": "workspace:*",
    "@source-taster/contract-verification": "workspace:*",
    "@source-taster/i18n": "workspace:*",
    "@source-taster/ui": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5"
  }
}
