{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": [
    "CI",
    "DATABASE_*",
    "SOURCE_TASTER_*",
    "PLAYWRIGHT_BROWSERS_PATH"
  ],
  "tasks": {
    "generate": {
      "outputs": ["src/generated/**", "src/paraglide/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "lint": {
      "dependsOn": ["^build", "generate"]
    },
    "i18n:check": {},
    "test": {
      "dependsOn": ["^build", "generate"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build", "generate"],
      "cache": false
    }
  }
}
