# Explicit standalone opt-in. Hosted authority is not available and fails closed.
SOURCE_TASTER_MODE=standalone
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5433/postgres
DATABASE_URL=postgres://verification_app:verification_app@localhost:5433/source_taster
SOURCE_TASTER_PORT=3100
# Optional technical settings, in milliseconds:
SOURCE_TASTER_SSE_HEARTBEAT_MS=25000
SOURCE_TASTER_PLACEHOLDER_DELAY_MS=0
# Local-only development opt-in; cannot be released or activated in production.
# SOURCE_TASTER_DOI_PREVIEW=uncalibrated

# Maximum recognized References per Structuring preview (positive integer).
SOURCE_TASTER_REFERENCE_LIMIT=1000
