# Explicit standalone opt-in. Hosted authority is not available and fails closed.
SOURCE_TASTER_MODE=standalone
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5433/postgres
DATABASE_URL=postgres://verification_app:verification_app@localhost:5433/source_taster
SOURCE_TASTER_PORT=3100
# Optional technical settings, in milliseconds:
SOURCE_TASTER_SSE_HEARTBEAT_MS=25000
SOURCE_TASTER_PLACEHOLDER_DELAY_MS=0
# Local-only development opt-in; cannot be released or activated in production.
# SOURCE_TASTER_DOI_PREVIEW=uncalibrated
# Version 2 bibliographic search is a separate development-only opt-in.
# SOURCE_TASTER_BIBLIOGRAPHIC_PREVIEW=uncalibrated
# SOURCE_TASTER_OPENALEX_ENABLED=true
# Book/chapter catalogs are separately enabled; disabled is not an outage.
# SOURCE_TASTER_OPENLIBRARY_ENABLED=true
# SOURCE_TASTER_GOOGLEBOOKS_ENABLED=true
# Positive global catalog request rates; changes are versioned gate inputs.
# SOURCE_TASTER_OPENLIBRARY_REQUESTS_PER_SECOND=3
# SOURCE_TASTER_GOOGLEBOOKS_REQUESTS_PER_SECOND=1

# Maximum recognized References per Structuring preview (positive integer).
SOURCE_TASTER_REFERENCE_LIMIT=1000

# Whole-Check client lease; clients acknowledge every one third of this period.
# Closing a connection is not immediate cancellation. Expiry ends unfinished work.
SOURCE_TASTER_CLIENT_LEASE_MS=75000
# Durable execution claim; recovery retains the original 30-second source deadline.
SOURCE_TASTER_WORKER_CLAIM_MS=45000
