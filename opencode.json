{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "pnpm lint*": "allow",
      "pnpm typecheck*": "allow",
      "pnpm test*": "allow",
      "pnpm build*": "allow",
      "pnpm dev*": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git branch*": "allow",
      "git show*": "allow"
    },
    "edit": {
      "*": "allow",
      "AGENTS.md": "ask",
      "CLAUDE.md": "ask",
      "opencode.json": "ask",
      ".opencode/**": "ask",
      ".claude/**": "ask",
      ".mcp.json": "ask",
      ".github/workflows/**": "ask",
      "docs/ai-os/**": "ask",
      "masterarbeit_nawroth_cicek.md": "deny"
    },
    "external_directory": { "*": "deny" }
  },
  "subagent_depth": 2,
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "{env:PWD}"]
    }
  }
}
