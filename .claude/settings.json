{
  "permissions": {
    "allow": [
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(pnpm build*)",
      "Bash(pnpm dev*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(node --test .claude/hooks/*)",
      "Bash(node docs/ai-os/evaluation/check-governance.mjs)"
    ],
    "ask": [
      "Bash(git push *)",
      "Edit(AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Edit(docs/ai-os/**)",
      "Write(docs/ai-os/**)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(.opencode/**)",
      "Write(.opencode/**)",
      "Edit(opencode.json)",
      "Edit(.mcp.json)",
      "Edit(.github/workflows/**)",
      "Write(.github/workflows/**)",
      "Edit(.github/CODEOWNERS)"
    ],
    "deny": [
      "Read(.keystore/**)",
      "Read(.env)",
      "Read(apps/api/.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Edit(.keystore/**)",
      "Write(.keystore/**)",
      "Edit(**/.env)",
      "Write(**/.env)",
      "Edit(**/.env.local)",
      "Write(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Write(**/.env.*.local)",
      "Edit(masterarbeit_nawroth_cicek.md)",
      "Write(masterarbeit_nawroth_cicek.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "autoMemoryEnabled": false
}
