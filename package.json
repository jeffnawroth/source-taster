{
  "name": "source-taster",
  "type": "module",
  "version": "2.3.2",
  "private": true,
  "packageManager": "pnpm@11.14.0",
  "description": "Browser extension and API for automated academic reference verification. Extracts, searches, and validates sources across 5 databases — detects AI-hallucinated references with 100% accuracy.",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm dev:kill && pnpm build:types && pnpm run -r --parallel --aggregate-output dev",
    "dev:kill": "lsof -t -i :5173 -i :4321 -i :3303 -i :8000 | xargs kill 2>/dev/null; true",
    "dev:docker": "pnpm dev:kill && docker compose up -d anystyle && pnpm dev",
    "build": "pnpm run -r build",
    "build:api": "pnpm --filter @source-taster/api build",
    "build:extension": "pnpm --filter @source-taster/extension build",
    "build:landing": "pnpm --filter @source-taster/landing build",
    "dev:landing": "pnpm --filter @source-taster/landing dev",
    "build:types": "pnpm --filter @source-taster/types build",
    "typecheck": "pnpm run -r --parallel --aggregate-output typecheck",
    "preview": "pnpm run -r --parallel preview",
    "test": "pnpm run -r --parallel test",
    "lint": "pnpm run -r --parallel lint",
    "deploy": "pnpm build && pnpm run -r deploy",
    "docker:build:api": "docker compose build api",
    "docker:build:docs": "docker compose build docs",
    "docker:build:landing": "docker compose build landing",
    "docker:build:all": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "preinstall": "simple-git-hooks",
    "evaluation": "node evaluation/run-evaluation.js",
    "evaluation:export-crossref": "node evaluation/export-crossref-raw.js",
    "evaluation:run-live": "node evaluation/run-live-pipeline.js",
    "evaluation:prepare-input": "node evaluation/build-live-input.js",
    "evaluation:perturb-apa": "node evaluation/perturb-apa-references.js",
    "evaluation:perturb-summary": "node evaluation/summarize-perturbation-report.js",
    "eval:ai": "node evaluation/ai-system/check-governance.mjs"
  },
  "devDependencies": {
    "@citation-js/plugin-csl": "^0.7.22",
    "bumpp": "^10.4.1",
    "citation-js": "^0.7.22",
    "conventional-changelog-cli": "^5.0.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "eslint": "^9.39.5",
    "lint-staged": "^16.4.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm build:types && pnpm typecheck && pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,vue,json,html,css}": "eslint --fix"
  }
}
