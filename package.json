{
  "name": "source-taster",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "tsc -p scripts/tsconfig.json && turbo run typecheck",
    "lint": "eslint scripts && turbo run lint && prettier --check .",
    "format": "prettier --write .",
    "i18n:check": "turbo run i18n:check",
    "db:setup": "pnpm --filter @source-taster/server db:setup",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "audit:dependencies": "node scripts/audit.ts",
    "audit:licenses": "node scripts/licenses.ts",
    "pagefind:fetch": "node scripts/pagefind-source.ts fetch",
    "pagefind:build": "node scripts/pagefind-source.ts build",
    "pagefind:verify": "node scripts/pagefind-source.ts verify"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.0",
    "yaml": "2.9.1"
  }
}
