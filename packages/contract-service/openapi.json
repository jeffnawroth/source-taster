{
  "openapi": "3.1.0",
  "info": {
    "title": "Source Taster service API",
    "version": "1"
  },
  "components": {
    "schemas": {
      "ServiceStatusResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "program": {
                "type": "string",
                "enum": [
                  "service"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "ready"
                ]
              },
              "authentication": {
                "type": "string",
                "enum": [
                  "unavailable"
                ]
              }
            },
            "required": [
              "program",
              "status",
              "authentication"
            ]
          },
          "quota": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Quota"
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "not-implemented"
                    ]
                  }
                },
                "required": [
                  "status"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "data",
          "quota"
        ]
      },
      "Quota": {
        "type": "object",
        "properties": {
          "consumed": {
            "type": "integer",
            "minimum": 0
          },
          "remaining": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "consumed",
          "remaining"
        ]
      },
      "GuestTokenResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "accessToken": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "tokenType": {
                "type": "string",
                "enum": [
                  "Bearer"
                ]
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time"
              },
              "expiresIn": {
                "type": "number",
                "enum": [
                  300
                ]
              }
            },
            "required": [
              "accessToken",
              "tokenType",
              "expiresAt",
              "expiresIn"
            ],
            "additionalProperties": false
          },
          "quota": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Quota"
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "not-implemented"
                    ]
                  }
                },
                "required": [
                  "status"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "data",
          "quota"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "code": {
            "type": "string"
          },
          "i18nKey": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "i18nKey"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/status": {
      "get": {
        "summary": "Read infrastructure readiness; authentication is not implemented",
        "responses": {
          "200": {
            "description": "Ready; no authorization or Quota is granted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/guest-tokens": {
      "post": {
        "summary": "Issue or renew a five-minute Guest access token; no Quota grant",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "guestId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "client": {
                    "type": "string",
                    "enum": [
                      "web",
                      "extension"
                    ]
                  }
                },
                "required": [
                  "guestId",
                  "client"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Guest verification access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuestTokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Denied or unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Denied or unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Denied or unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/jwks.json": {
      "get": {
        "summary": "Current public access-token keys",
        "responses": {
          "200": {
            "description": "Ed25519 JWKS",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "keys": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "kty": {
                            "type": "string",
                            "enum": [
                              "OKP"
                            ]
                          },
                          "crv": {
                            "type": "string",
                            "enum": [
                              "Ed25519"
                            ]
                          },
                          "x": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]{43}$"
                          },
                          "kid": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 80
                          },
                          "alg": {
                            "type": "string",
                            "enum": [
                              "EdDSA"
                            ]
                          },
                          "use": {
                            "type": "string",
                            "enum": [
                              "sig"
                            ]
                          }
                        },
                        "required": [
                          "kty",
                          "crv",
                          "x",
                          "kid",
                          "alg",
                          "use"
                        ],
                        "additionalProperties": false
                      },
                      "maxItems": 5
                    }
                  },
                  "required": [
                    "keys"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Denied or unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
