{
  "name": "@source-taster/contract-service",
  "version": "0.0.0",
  "description": "Public service API skeleton; no Account or authentication implementation.",
  "license": "AGPL-3.0-or-later OR MIT",
  "type": "module",
  "files": [
    "dist",
    "LICENSE-AGPL",
    "LICENSE-MIT",
    "openapi.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/contract-service/src/index.d.ts",
      "default": "./dist/contract-service/src/index.js"
    },
    "./routes": {
      "types": "./dist/contract-service/src/routes.d.ts",
      "default": "./dist/contract-service/src/routes.js"
    },
    "./openapi.json": "./openapi.json"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "private": true
}
