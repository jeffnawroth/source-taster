{
  "openapi": "3.1.0",
  "info": {
    "title": "Source Taster internal API",
    "version": "1"
  },
  "components": {
    "schemas": {
      "QuotaSnapshotResponse": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "outcome": {
                "type": "string",
                "enum": [
                  "granted"
                ]
              },
              "quota": {
                "$ref": "#/components/schemas/Quota"
              }
            },
            "required": [
              "outcome",
              "quota"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "outcome": {
                "type": "string",
                "enum": [
                  "denied"
                ]
              },
              "reason": {
                "type": "string",
                "enum": [
                  "revoked",
                  "forbidden",
                  "unknown"
                ]
              }
            },
            "required": [
              "outcome",
              "reason"
            ],
            "additionalProperties": false
          }
        ]
      },
      "Quota": {
        "type": "object",
        "properties": {
          "consumed": {
            "type": "integer",
            "minimum": 0
          },
          "remaining": {
            "type": "integer",
            "minimum": 0
          },
          "granted": {
            "type": "integer",
            "minimum": 0
          },
          "reserved": {
            "type": "integer",
            "minimum": 0
          },
          "warning": {
            "$ref": "#/components/schemas/QuotaWarning"
          },
          "grants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuotaGrantView"
            },
            "maxItems": 50
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "maxItems": 20
          }
        },
        "required": [
          "consumed",
          "remaining",
          "granted",
          "reserved",
          "warning",
          "grants",
          "features"
        ]
      },
      "QuotaWarning": {
        "type": "string",
        "enum": [
          "none",
          "eighty",
          "exhausted"
        ]
      },
      "QuotaGrantView": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "guest",
              "free",
              "credit"
            ]
          },
          "granted": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "remaining": {
            "type": "integer",
            "minimum": 0
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "kind",
          "granted",
          "remaining",
          "expiresAt"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "available": {
            "type": "integer",
            "minimum": 0
          },
          "required": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "code": {
            "type": "string"
          },
          "i18nKey": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "i18nKey"
        ]
      },
      "QuotaSnapshotRequest": {
        "type": "object",
        "properties": {
          "ownerId": {
            "type": "string",
            "format": "uuid"
          },
          "actorId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "ownerId",
          "actorId"
        ],
        "additionalProperties": false
      },
      "QuotaReserveResponse": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "outcome": {
                "type": "string",
                "enum": [
                  "reserved"
                ]
              },
              "free": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "maxItems": 2000
              },
              "reserved": {
                "type": "integer",
                "minimum": 0
              },
              "quota": {
                "$ref": "#/components/schemas/Quota"
              }
            },
            "required": [
              "outcome",
              "free",
              "reserved",
              "quota"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "outcome": {
                "type": "string",
                "enum": [
                  "insufficient"
                ]
              },
              "available": {
                "type": "integer",
                "minimum": 0
              },
              "required": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "quota": {
                "$ref": "#/components/schemas/Quota"
              }
            },
            "required": [
              "outcome",
              "available",
              "required",
              "quota"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "outcome": {
                "type": "string",
                "enum": [
                  "denied"
                ]
              },
              "reason": {
                "type": "string",
                "enum": [
                  "revoked",
                  "forbidden",
                  "unknown"
                ]
              }
            },
            "required": [
              "outcome",
              "reason"
            ],
            "additionalProperties": false
          }
        ]
      },
      "QuotaReserveRequest": {
        "type": "object",
        "properties": {
          "ownerId": {
            "type": "string",
            "format": "uuid"
          },
          "actorId": {
            "type": "string",
            "format": "uuid"
          },
          "checkId": {
            "type": "string",
            "format": "uuid"
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "position": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "generation": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "position",
                "generation"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 2000
          }
        },
        "required": [
          "ownerId",
          "actorId",
          "checkId",
          "key",
          "slots"
        ],
        "additionalProperties": false
      },
      "QuotaSettleResponse": {
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "debited",
              "released",
              "free",
              "forgiven",
              "ignored"
            ]
          }
        },
        "required": [
          "outcome"
        ],
        "additionalProperties": false
      },
      "QuotaSettleRequest": {
        "type": "object",
        "properties": {
          "ownerId": {
            "type": "string",
            "format": "uuid"
          },
          "actorId": {
            "type": "string",
            "format": "uuid"
          },
          "checkId": {
            "type": "string",
            "format": "uuid"
          },
          "position": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "generation": {
            "type": "integer",
            "minimum": 0
          },
          "outcome": {
            "type": "string",
            "enum": [
              "verdict",
              "release"
            ]
          }
        },
        "required": [
          "ownerId",
          "actorId",
          "checkId",
          "position",
          "generation",
          "outcome"
        ],
        "additionalProperties": false
      },
      "QuotaReleaseResponse": {
        "type": "object",
        "properties": {
          "released": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "released"
        ],
        "additionalProperties": false
      },
      "QuotaReleaseRequest": {
        "type": "object",
        "properties": {
          "ownerId": {
            "type": "string",
            "format": "uuid"
          },
          "actorId": {
            "type": "string",
            "format": "uuid"
          },
          "checkId": {
            "type": "string",
            "format": "uuid"
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "ownerId",
          "actorId",
          "checkId",
          "key"
        ],
        "additionalProperties": false
      },
      "AuthorityResponse": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "allowed": {
                "type": "boolean",
                "enum": [
                  true
                ]
              },
              "version": {
                "type": "integer",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "allowed",
              "version"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "allowed": {
                "type": "boolean",
                "enum": [
                  false
                ]
              },
              "reason": {
                "type": "string",
                "enum": [
                  "revoked",
                  "forbidden",
                  "unknown"
                ]
              }
            },
            "required": [
              "allowed",
              "reason"
            ],
            "additionalProperties": false
          }
        ]
      },
      "MailRehearsalResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "language": {
                "type": "string",
                "enum": [
                  "de",
                  "en"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "queued",
                  "sent"
                ]
              }
            },
            "required": [
              "id",
              "language",
              "status"
            ]
          },
          "quota": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Quota"
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "not-implemented"
                    ]
                  }
                },
                "required": [
                  "status"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "data",
          "quota"
        ]
      },
      "MailRehearsalRequest": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "de",
              "en"
            ]
          }
        },
        "required": [
          "language"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/internal/quota/snapshot": {
      "post": {
        "summary": "Current balance of an Owner (signed verification assertion)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuotaSnapshotRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Durable Quota decision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuotaSnapshotResponse"
                }
              }
            }
          },
          "400": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/internal/quota/reserve": {
      "post": {
        "summary": "Atomically reserve one unit per unbilled Reference slot, all or nothing",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuotaReserveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Durable Quota decision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuotaReserveResponse"
                }
              }
            }
          },
          "400": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/internal/quota/settle": {
      "post": {
        "summary": "Idempotently debit a slot on its first Verdict or release its reservation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuotaSettleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Durable Quota decision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuotaSettleResponse"
                }
              }
            }
          },
          "400": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/internal/quota/release": {
      "post": {
        "summary": "Release what an unused reservation still holds",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuotaReleaseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Durable Quota decision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuotaReleaseResponse"
                }
              }
            }
          },
          "400": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/internal/account-authority": {
      "post": {
        "summary": "Check current Account/Owner authority and current session for requests",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "actorId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "ownerId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "sessionId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "permission": {
                    "type": "string",
                    "enum": [
                      "structuring:create",
                      "check:create",
                      "check:read",
                      "check:cancel",
                      "check:renew"
                    ]
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "request",
                      "work"
                    ]
                  }
                },
                "required": [
                  "actorId",
                  "ownerId",
                  "permission",
                  "kind"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current authority",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorityResponse"
                }
              }
            }
          },
          "400": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/internal/mail-rehearsals": {
      "post": {
        "summary": "Local SMTP rehearsal; fixed sink only, never an Account sign-in",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "required": true,
            "name": "idempotency-key",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MailRehearsalRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Durable local rehearsal receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MailRehearsalResponse"
                }
              }
            }
          },
          "400": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/internal/mail-rehearsals/{id}": {
      "get": {
        "summary": "Read local rehearsal delivery status",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Local rehearsal status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MailRehearsalResponse"
                }
              }
            }
          },
          "400": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/internal/guest-authority": {
      "post": {
        "summary": "Check current Guest binding and named permission (signed verification assertion)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "guestContextId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "ownerId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "actorId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "permission": {
