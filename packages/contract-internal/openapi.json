{
  "openapi": "3.1.0",
  "info": {
    "title": "Source Taster internal API",
    "version": "1"
  },
  "components": {
    "schemas": {
      "AbusePolicy": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "cacheMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30000
          },
          "public": {
            "type": "object",
            "properties": {
              "principal": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "limit": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 1000000000
                    },
                    "windowMs": {
                      "type": "integer",
                      "minimum": 1000,
                      "maximum": 86400000
                    }
                  },
                  "required": [
                    "limit",
                    "windowMs"
                  ],
                  "additionalProperties": false
                }
              },
              "guest": {
                "type": "object",
                "properties": {
                  "limit": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000000
                  },
                  "windowMs": {
                    "type": "integer",
                    "minimum": 1000,
                    "maximum": 86400000
                  }
                },
                "required": [
                  "limit",
                  "windowMs"
                ],
                "additionalProperties": false
              },
              "allGuests": {
                "type": "object",
                "properties": {
                  "limit": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000000
                  },
                  "windowMs": {
                    "type": "integer",
                    "minimum": 1000,
                    "maximum": 86400000
                  }
                },
                "required": [
                  "limit",
                  "windowMs"
                ],
                "additionalProperties": false
              },
              "origin": {
                "type": "object",
                "properties": {
                  "limit": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000000
                  },
                  "windowMs": {
                    "type": "integer",
                    "minimum": 1000,
                    "maximum": 86400000
                  }
                },
                "required": [
                  "limit",
                  "windowMs"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "principal",
              "guest",
              "allGuests",
              "origin"
            ],
            "additionalProperties": false
          },
          "shared": {
            "type": "object",
            "properties": {
              "principal": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "limit": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 1000000000
                    },
                    "windowMs": {
                      "type": "integer",
                      "minimum": 1000,
                      "maximum": 86400000
                    }
                  },
                  "required": [
                    "limit",
                    "windowMs"
                  ],
                  "additionalProperties": false
                }
              },
              "guest": {
                "type": "object",
                "properties": {
                  "limit": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000000
                  },
                  "windowMs": {
                    "type": "integer",
                    "minimum": 1000,
                    "maximum": 86400000
                  }
                },
                "required": [
                  "limit",
                  "windowMs"
                ],
                "additionalProperties": false
              },
              "allGuests": {
                "type": "object",
                "properties": {
                  "limit": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000000
                  },
                  "windowMs": {
                    "type": "integer",
                    "minimum": 1000,
                    "maximum": 86400000
                  }
                },
                "required": [
                  "limit",
                  "windowMs"
                ],
                "additionalProperties": false
              },
              "origin": {
                "type": "object",
                "properties": {
                  "limit": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000000
                  },
                  "windowMs": {
                    "type": "integer",
                    "minimum": 1000,
                    "maximum": 86400000
                  }
                },
                "required": [
                  "limit",
                  "windowMs"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "principal",
              "guest",
              "allGuests",
              "origin"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "version",
          "cacheMs",
          "public",
          "shared"
        ],
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "retryAt": {
            "type": "string",
            "format": "date-time"
          },
          "code": {
            "type": "string"
          },
          "i18nKey": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "i18nKey"
        ]
      },
      "AbuseDecision": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "allowed": {
                "type": "boolean",
                "enum": [
                  true
                ]
              },
              "policyVersion": {
                "type": "string"
              },
              "planId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "allowed",
              "policyVersion",
              "planId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "allowed": {
                "type": "boolean",
                "enum": [
                  false
                ]
              },
              "planId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "policyVersion": {
                "type": "string"
              },
              "retryAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "allowed",
              "planId",
              "policyVersion",
              "retryAt"
            ],
            "additionalProperties": false
          }
        ]
      },
      "AbuseEntrance": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "program": {
            "type": "string",
            "enum": [
              "verification"
            ]
          },
          "policyVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "principal": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "ownerId": {
                "type": "string",
                "format": "uuid"
              },
              "actorId": {
                "type": "string",
                "format": "uuid"
              },
              "guestId": {
                "type": "string",
                "format": "uuid"
              },
              "guestContextId": {
                "type": "string",
                "format": "uuid"
              },
              "sessionId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "ownerId",
              "actorId"
            ],
            "additionalProperties": false
          },
          "origins": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "windowMs": {
                  "type": "integer",
                  "minimum": 1000,
                  "maximum": 86400000
                },
                "windowStart": {
                  "type": "integer",
                  "minimum": 0
                },
                "keyId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "windowMs",
                "windowStart",
                "keyId",
                "hash"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 2
          }
        },
        "required": [
          "requestId",
          "program",
          "policyVersion",
          "principal",
          "origins"
        ],
        "additionalProperties": false
      },
      "AuthorityResponse": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "allowed": {
                "type": "boolean",
                "enum": [
                  true
                ]
              },
              "version": {
                "type": "integer",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "allowed",
              "version"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "allowed": {
                "type": "boolean",
                "enum": [
                  false
                ]
              },
              "reason": {
                "type": "string",
                "enum": [
                  "revoked",
                  "forbidden",
                  "unknown"
                ]
              }
            },
            "required": [
              "allowed",
              "reason"
            ],
            "additionalProperties": false
          }
        ]
      },
      "MailRehearsalResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "language": {
                "type": "string",
                "enum": [
                  "de",
                  "en"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "queued",
                  "sent"
                ]
              }
            },
            "required": [
              "id",
              "language",
              "status"
            ]
          },
          "quota": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Quota"
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "not-implemented"
                    ]
                  }
                },
                "required": [
                  "status"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "data",
          "quota"
        ]
      },
      "Quota": {
        "type": "object",
        "properties": {
          "consumed": {
            "type": "integer",
            "minimum": 0
          },
          "remaining": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "consumed",
          "remaining"
        ]
      },
      "MailRehearsalRequest": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "de",
              "en"
            ]
          }
        },
        "required": [
          "language"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/internal/abuse/policy": {
      "post": {
        "summary": "Operator-maintained entrance budgets; signed abuse-entrance assertion, briefly cached settings only",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current public and combined-service budgets",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AbusePolicy"
                }
              }
            }
          },
          "401": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/internal/abuse/entrances": {
      "post": {
        "summary": "Atomically count combined budgets across both programs; current Plan, no cached allowance",
        "description": "Service owns one PostgreSQL transaction for all shared dimensions and both entrances, deduplicated by requestId. It validates current binding and ingress hash/window/key context. Only IDs/counts and minimized hashes cross; no IPs/content/credentials. Stale policy, unknown binding or outage fails closed. Private bootstrap/cancellation remain Account-existence neutral. Every attempt counts, including a denial; maximum retryAt across exceeded budgets. Idempotency expires within 24h.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AbuseEntrance"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One non-cacheable combined decision and current Plan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AbuseDecision"
                }
              }
            }
          },
          "400": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/internal/account-authority": {
      "post": {
        "summary": "Check current Account/Owner authority and current session for requests",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "actorId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "ownerId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "sessionId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "permission": {
                    "type": "string",
                    "enum": [
                      "structuring:create",
                      "check:create",
                      "check:read",
                      "check:cancel",
                      "check:renew"
                    ]
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "request",
                      "work"
                    ]
                  }
                },
                "required": [
                  "actorId",
                  "ownerId",
                  "permission",
                  "kind"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current authority",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorityResponse"
                }
              }
            }
          },
          "400": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/internal/mail-rehearsals": {
      "post": {
        "summary": "Local SMTP rehearsal; fixed sink only, never an Account sign-in",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "required": true,
            "name": "idempotency-key",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MailRehearsalRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Durable local rehearsal receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MailRehearsalResponse"
                }
              }
            }
          },
          "400": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/internal/mail-rehearsals/{id}": {
      "get": {
        "summary": "Read local rehearsal delivery status",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Local rehearsal status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MailRehearsalResponse"
                }
              }
            }
          },
          "400": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/internal/guest-authority": {
      "post": {
        "summary": "Check current Guest binding and named permission (signed verification assertion)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "guestContextId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "ownerId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "actorId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "permission": {
                    "type": "string",
                    "enum": [
                      "structuring:create",
                      "check:create",
                      "check:read",
                      "check:cancel",
                      "check:renew"
                    ]
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "request",
                      "work"
                    ]
                  }
                },
                "required": [
                  "guestContextId",
                  "ownerId",
                  "actorId",
                  "permission",
                  "kind"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current authority, never a cacheable allowance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorityResponse"
                }
              }
            }
          },
          "400": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/internal/guest-authority/invalidate": {
      "post": {
        "summary": "Install/drain a versioned Owner fence (signed service assertion)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "guestContextId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "ownerId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "actorId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "version": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "cancelWork": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "ownerId",
                  "actorId",
                  "version",
                  "cancelWork"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Durable drained fence acknowledgement",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ownerId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "version": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "ownerId",
                    "version"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
