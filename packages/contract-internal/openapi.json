{
  "openapi": "3.1.0",
  "info": {
    "title": "Source Taster internal API",
    "version": "1"
  },
  "components": {
    "schemas": {
      "AuthorityResponse": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "allowed": {
                "type": "boolean",
                "enum": [
                  true
                ]
              },
              "version": {
                "type": "integer",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "allowed",
              "version"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "allowed": {
                "type": "boolean",
                "enum": [
                  false
                ]
              },
              "reason": {
                "type": "string",
                "enum": [
                  "revoked",
                  "forbidden",
                  "unknown"
                ]
              }
            },
            "required": [
              "allowed",
              "reason"
            ],
            "additionalProperties": false
          }
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "code": {
            "type": "string"
          },
          "i18nKey": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "i18nKey"
        ]
      },
      "MailRehearsalResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "language": {
                "type": "string",
                "enum": [
                  "de",
                  "en"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "queued",
                  "sent"
                ]
              }
            },
            "required": [
              "id",
              "language",
              "status"
            ]
          },
          "quota": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Quota"
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "not-implemented"
                    ]
                  }
                },
                "required": [
                  "status"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "data",
          "quota"
        ]
      },
      "Quota": {
        "type": "object",
        "properties": {
          "consumed": {
            "type": "integer",
            "minimum": 0
          },
          "remaining": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "consumed",
          "remaining"
        ]
      },
      "MailRehearsalRequest": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "de",
              "en"
            ]
          }
        },
        "required": [
          "language"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/internal/account-authority": {
      "post": {
        "summary": "Check current Account/Owner authority and current session for requests",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "actorId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "ownerId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "sessionId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "permission": {
                    "type": "string",
                    "enum": [
                      "structuring:create",
                      "check:create",
                      "check:read",
                      "check:cancel",
                      "check:renew"
                    ]
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "request",
                      "work"
                    ]
                  }
                },
                "required": [
                  "actorId",
                  "ownerId",
                  "permission",
                  "kind"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current authority",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorityResponse"
                }
              }
            }
          },
          "400": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/internal/mail-rehearsals": {
      "post": {
        "summary": "Local SMTP rehearsal; fixed sink only, never an Account sign-in",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "required": true,
            "name": "idempotency-key",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MailRehearsalRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Durable local rehearsal receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MailRehearsalResponse"
                }
              }
            }
          },
          "400": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/internal/mail-rehearsals/{id}": {
      "get": {
        "summary": "Read local rehearsal delivery status",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Local rehearsal status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MailRehearsalResponse"
                }
              }
            }
          },
          "400": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/internal/guest-authority": {
      "post": {
        "summary": "Check current Guest binding and named permission (signed verification assertion)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "guestContextId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "ownerId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "actorId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "permission": {
                    "type": "string",
                    "enum": [
                      "structuring:create",
                      "check:create",
                      "check:read",
                      "check:cancel",
                      "check:renew"
                    ]
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "request",
                      "work"
                    ]
                  }
                },
                "required": [
                  "guestContextId",
                  "ownerId",
                  "actorId",
                  "permission",
                  "kind"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current authority, never a cacheable allowance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorityResponse"
                }
              }
            }
          },
          "400": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/internal/guest-authority/invalidate": {
      "post": {
        "summary": "Install/drain a versioned Owner fence (signed service assertion)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "guestContextId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "ownerId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "actorId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "version": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "cancelWork": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "ownerId",
                  "actorId",
                  "version",
                  "cancelWork"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Durable drained fence acknowledgement",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ownerId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "version": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "ownerId",
                    "version"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Problem Details; the local diagnostic is unavailable by default",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
