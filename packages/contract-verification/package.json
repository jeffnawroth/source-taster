{
  "name": "@source-taster/contract-verification",
  "version": "0.0.0",
  "description": "Public transport contract of the Source Taster verification API (/v1): schemas, routes and client.",
  "license": "AGPL-3.0-or-later OR MIT",
  "type": "module",
  "files": [
    "dist",
    "LICENSE-AGPL",
    "LICENSE-MIT",
    "openapi.json",
    "openapi-v2.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/contract-verification/src/index.d.ts",
      "default": "./dist/contract-verification/src/index.js"
    },
    "./routes": {
      "types": "./dist/contract-verification/src/routes.d.ts",
      "default": "./dist/contract-verification/src/routes.js"
    },
    "./client": {
      "types": "./dist/contract-verification/src/client.d.ts",
      "default": "./dist/contract-verification/src/client.js"
    },
    "./openapi.json": "./openapi.json",
    "./v2": {
      "types": "./dist/contract-verification/src/v2.d.ts",
      "default": "./dist/contract-verification/src/v2.js"
    },
    "./routes-v2": {
      "types": "./dist/contract-verification/src/routes-v2.d.ts",
      "default": "./dist/contract-verification/src/routes-v2.js"
    },
    "./client-v2": {
      "types": "./dist/contract-verification/src/client-v2.d.ts",
      "default": "./dist/contract-verification/src/client-v2.js"
    },
    "./openapi-v2.json": "./openapi-v2.json",
    "./bibliography": {
      "types": "./dist/contract-verification/src/bibliography.d.ts",
      "default": "./dist/contract-verification/src/bibliography.js"
    },
    "./bibliography-routes": {
      "types": "./dist/contract-verification/src/bibliography-routes.d.ts",
      "default": "./dist/contract-verification/src/bibliography-routes.js"
    },
    "./bibliography-client": {
      "types": "./dist/contract-verification/src/bibliography-client.d.ts",
      "default": "./dist/contract-verification/src/bibliography-client.js"
    },
    "./export": {
      "types": "./dist/contract-verification/src/export.d.ts",
      "default": "./dist/contract-verification/src/export.js"
    },
    "./export-routes": {
      "types": "./dist/contract-verification/src/export-routes.d.ts",
      "default": "./dist/contract-verification/src/export-routes.js"
    },
    "./export-client": {
      "types": "./dist/contract-verification/src/export-client.d.ts",
      "default": "./dist/contract-verification/src/export-client.js"
    },
    "./report": {
      "types": "./dist/contract-verification/src/report.d.ts",
      "default": "./dist/contract-verification/src/report.js"
    },
    "./report-routes": {
      "types": "./dist/contract-verification/src/report-routes.d.ts",
      "default": "./dist/contract-verification/src/report-routes.js"
    },
    "./report-client": {
      "types": "./dist/contract-verification/src/report-client.d.ts",
      "default": "./dist/contract-verification/src/report-client.js"
    },
    "./document": {
      "types": "./dist/contract-verification/src/document.d.ts",
      "default": "./dist/contract-verification/src/document.js"
    },
    "./document-routes": {
      "types": "./dist/contract-verification/src/document-routes.d.ts",
      "default": "./dist/contract-verification/src/document-routes.js"
    },
    "./document-client": {
      "types": "./dist/contract-verification/src/document-client.d.ts",
      "default": "./dist/contract-verification/src/document-client.js"
    },
    "./import": {
      "types": "./dist/contract-verification/src/import.d.ts",
      "default": "./dist/contract-verification/src/import.js"
    },
    "./ai": {
      "types": "./dist/contract-verification/src/ai.d.ts",
      "default": "./dist/contract-verification/src/ai.js"
    },
    "./data-subject-routes": {
      "types": "./dist/contract-verification/src/data-subject-routes.d.ts",
      "default": "./dist/contract-verification/src/data-subject-routes.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "hono": "4.13.17",
    "zod": "4.6.7"
  },
  "private": true
}
