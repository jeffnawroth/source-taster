{
  "name": "@source-taster/contract-verification",
  "version": "0.0.0",
  "description": "Public transport contract of the Source Taster verification API (/v1): schemas, routes and client.",
  "license": "AGPL-3.0-or-later OR MIT",
  "type": "module",
  "files": [
    "dist",
    "LICENSE-AGPL",
    "LICENSE-MIT"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./routes": {
      "types": "./dist/routes.d.ts",
      "default": "./dist/routes.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "@source-taster/contract-common": "workspace:*",
    "hono": "4.13.14",
    "zod": "4.6.7"
  }
}
