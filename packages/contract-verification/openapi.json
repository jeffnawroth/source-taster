{
  "openapi": "3.1.0",
  "info": {
    "title": "Source Taster verification API",
    "version": "1"
  },
  "components": {
    "schemas": {
      "CheckResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Check"
          },
          "quota": {
            "$ref": "#/components/schemas/Quota"
          }
        },
        "required": [
          "data",
          "quota"
        ]
      },
      "Check": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "$ref": "#/components/schemas/CheckState"
          },
          "lastEventSeq": {
            "type": "integer",
            "minimum": 0
          },
          "references": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReferenceSlot"
            }
          }
        },
        "required": [
          "id",
          "state",
          "lastEventSeq",
          "references"
        ]
      },
      "CheckState": {
        "type": "string",
        "enum": [
          "running",
          "ended"
        ]
      },
      "ReferenceSlot": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "originalText": {
            "type": "string"
          },
          "outcome": {
            "$ref": "#/components/schemas/ReferenceOutcome"
          }
        },
        "required": [
          "slot",
          "originalText",
          "outcome"
        ]
      },
      "ReferenceOutcome": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "status"
                ]
              },
              "status": {
                "$ref": "#/components/schemas/ReferenceStatus"
              }
            },
            "required": [
              "kind",
              "status"
            ]
          }
        ]
      },
      "ReferenceStatus": {
        "type": "string",
        "enum": [
          "running",
          "cancelled",
          "failed",
          "not-checked"
        ]
      },
      "Quota": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "consumed": {
            "type": "integer",
            "minimum": 0
          },
          "remaining": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "consumed",
          "remaining"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "code": {
            "type": "string"
          },
          "i18nKey": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "i18nKey"
        ]
      },
      "CreateCheckRequest": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "text"
        ]
      },
      "StructuringResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "references": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "originalText": {
                      "type": "string"
                    },
                    "span": {
                      "type": "object",
                      "properties": {
                        "start": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "end": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "start",
                        "end"
                      ]
                    },
                    "csl": {
                      "type": "object",
                      "properties": {
                        "author": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "family": {
                                "type": "string"
                              },
                              "given": {
                                "type": "string"
                              },
                              "literal": {
                                "type": "string"
                              }
                            }
                          }
                        },
                        "issued": {
                          "type": "object",
                          "properties": {
                            "literal": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "literal"
                          ]
                        },
                        "title": {
                          "type": "string"
                        },
                        "container-title": {
                          "type": "string"
                        },
                        "container-title-short": {
                          "type": "string"
                        },
                        "publisher": {
                          "type": "string"
                        },
                        "publisher-place": {
                          "type": "string"
                        },
                        "volume": {
                          "type": "string"
                        },
                        "issue": {
                          "type": "string"
                        },
                        "page": {
                          "type": "string"
                        },
                        "article-number": {
                          "type": "string"
                        },
                        "edition": {
                          "type": "string"
                        },
                        "DOI": {
                          "type": "string"
                        },
                        "URL": {
                          "type": "string"
                        },
                        "ISBN": {
                          "type": "string"
                        },
                        "ISSN": {
                          "type": "string"
                        },
                        "PMID": {
                          "type": "string"
                        },
                        "PMCID": {
                          "type": "string"
                        }
                      }
                    },
                    "fieldSources": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "raw": {
                            "type": "string"
                          },
                          "span": {
                            "type": "object",
                            "properties": {
                              "start": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "end": {
                                "type": "integer",
                                "minimum": 0
                              }
                            },
                            "required": [
                              "start",
                              "end"
                            ]
                          },
                          "normalized": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "raw",
                          "span"
                        ]
                      }
                    },
                    "authorsTruncated": {
                      "type": "boolean"
                    },
                    "structuring": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string",
                          "enum": [
                            "parser"
                          ]
                        },
                        "version": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "path",
                        "version"
                      ]
                    }
                  },
                  "required": [
                    "originalText",
                    "span",
                    "csl",
                    "fieldSources",
                    "structuring"
                  ]
                }
              },
              "rejected": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "originalText": {
                      "type": "string"
                    },
                    "span": {
                      "type": "object",
                      "properties": {
                        "start": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "end": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "start",
                        "end"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "enum": [
                        "no-reference-features"
                      ]
                    }
                  },
                  "required": [
                    "originalText",
                    "span",
                    "reason"
                  ]
                }
              },
              "guidance": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "no-references"
                ]
              },
              "quotaConsumed": {
                "type": "number",
                "enum": [
                  0
                ]
              },
              "referenceLimit": {
                "type": "integer",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "references",
              "rejected",
              "guidance",
              "quotaConsumed",
              "referenceLimit"
            ]
          },
          "quota": {
            "$ref": "#/components/schemas/Quota"
          }
        },
        "required": [
          "data",
          "quota"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/checks": {
      "post": {
        "summary": "Paste References and start a Check",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCheckRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Check created; one Reference slot per pasted Reference.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckResponse"
                }
              }
            }
          },
          "400": {
            "description": "The input is empty, malformed, or exceeds the configured Reference limit.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/checks/{checkId}": {
      "get": {
        "summary": "Read the current snapshot of a Check",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "checkId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Current snapshot, including the newest event sequence.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckResponse"
                }
              }
            }
          },
          "400": {
            "description": "The Check id is malformed.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "No such Check for this Owner.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/checks/{checkId}/events": {
      "get": {
        "summary": "Stream Check events (Server-Sent Events)",
        "description": "Every event carries its sequence number as SSE `id` and a CheckEvent as JSON `data`. Send `Last-Event-ID` to receive only events after that sequence. The stream closes after the event that ends the Check.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "checkId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "last-event-id",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "text/event-stream of CheckEvent",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "The Check id or Last-Event-ID is malformed.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "No such Check for this Owner.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/structurings": {
      "post": {
        "summary": "Structure pasted References without starting a Check or consuming Quota",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "text"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recognized References, field provenance and rejected text.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StructuringResponse"
                }
              }
            }
          },
          "400": {
            "description": "The input is empty, malformed, or exceeds the Reference limit.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Sign-in required.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Not permitted.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
