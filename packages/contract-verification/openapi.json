            "enum": [
              "completed",
              "cancelled",
              "lease-expired",
              null
            ]
          },
          "references": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReferenceSlot"
            }
          }
        },
        "required": [
          "id",
          "state",
          "lastEventSeq",
          "lastEventCursor",
          "leaseRenewAfterMs",
          "endReason",
          "references"
        ]
      },
      "CheckState": {
        "type": "string",
